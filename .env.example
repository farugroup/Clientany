# ============================================================
# Clientany — variables de entorno
# Copiá este archivo como ".env.local" y completá los valores.
# Sin estas variables, la app corre en MODO DEMO (datos en el navegador).
# ============================================================

# --- Supabase (autenticación + base de datos) ---
# Las encontrás en tu proyecto de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (emails transaccionales / bienvenida) ---
# API key en https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado en tu dominio (https://resend.com/domains)
RESEND_FROM="Clientany <hola@tudominio.com>"

# --- App ---
# URL pública de tu app (para links de emails y OAuth). En Vercel se setea sola.
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# --- CRM multiempresa (ver docs/CRM.md y SUPABASE.md) ---
# Service role key de Supabase: el servidor escribe en las tablas crm_* y en el
# bucket crm-media con ella. NUNCA la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Clave de cifrado (AES-256-GCM) de los tokens de Meta y las claves de IA de
# cada empresa. Obligatoria en nube. Generala con: openssl rand -hex 32
CLIENTANY_SECRET=
# Clave de Anthropic para el copilot (IA de la plataforma). Opcional: cada
# empresa puede cargar la suya en Configuración → IA.
ANTHROPIC_API_KEY=
# Modelo del copilot (de fábrica claude-opus-5-5).
CLIENTANY_IA_MODELO=
# Versión de la Graph API de Meta (de fábrica v21.0).
CLIENTANY_GRAPH_VERSION=
# Desarrollo sin Supabase: "memory" guarda todo en .clientany-dev/db.json.
CLIENTANY_DB=
# Mail del usuario fijo en modo memoria (sirve para next dev y los tests).
CLIENTANY_DEV_USER=
# Fuerza el modo del navegador: "nube" o "demo" (si falta, lo decide la
# presencia de NEXT_PUBLIC_SUPABASE_URL).
NEXT_PUBLIC_CLIENTANY_MODO=
# Sólo para tests: con "1" la Graph API no se toca y devuelve datos de prueba.
# CLIENTANY_GRAPH_FAKE=
