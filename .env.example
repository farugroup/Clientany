# ============================================================
# Clientany — variables de entorno
# Copiá este archivo como ".env.local" y completá los valores.
# Sin estas variables, la app corre en MODO DEMO (datos en el navegador).
# ============================================================

# --- Supabase (autenticación + base de datos) ---
# Las encontrás en tu proyecto de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (emails transaccionales / bienvenida) ---
# API key en https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado en tu dominio (https://resend.com/domains)
RESEND_FROM="Clientany <hola@tudominio.com>"

# --- App ---
# URL pública de tu app (para links de emails y OAuth). En Vercel se setea sola.
NEXT_PUBLIC_APP_URL=https://tu-dominio.com
